# ========================================================
# SonicSplit AI Audio Separator - Frontend Configuration (.env.example)
# ========================================================

# Next.js Application Port
PORT=3000

# Backend API Gateway Base URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Application Settings
NEXT_PUBLIC_APP_NAME=SonicSplit Studio
NEXT_PUBLIC_DEFAULT_MODE=4-stem
NEXT_PUBLIC_MAX_FILE_SIZE_MB=100
