# ========================================================
# SonicSplit AI Audio Separator - Backend Configuration (.env.example)
# ========================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/vocal_splitter

# AI Stem Separation Configuration
DEMUCS_MODEL=htdemucs
DEMUCS_PRECISION=fp16weights
PYTHON_WORKER_TIMEOUT=600000

# Optional External Cloud AI Services
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
